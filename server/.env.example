# Copy to server/.env for local dev. Never commit server/.env.
PORT=8787
HOST=0.0.0.0

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"
# Port 6543, NOT 5432. Leave this unset to run on in-memory repos (health: degraded).
DATABASE_URL=

# Comma separated. The Vite dev server, the Vite preview server, and the live PWA.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://romeo-04.github.io

# Everything DB-facing gets 3s (docs/fe-be-task-assignment.md §6 BE-0).
TIMEOUT_MS=3000

# Absolute URL prefix for pet PNGs. Empty -> relative paths served by the PWA origin.
PET_ASSET_BASE_URL=

LOG_LEVEL=info
MIGRATE_ON_BOOT=false
